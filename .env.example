# ─────────────────────────────────────────────────────────────────────────────
#  SentinelWA :: environment configuration
#  Copy to `.env` and fill in. NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Public origin of this gateway. Used to build the Meta callback URL shown in
# /settings. Must be the HTTPS URL Meta can reach (via your Nginx reverse proxy).
APP_PUBLIC_URL=https://wa-gateway.internal.example.com

# ── Database (SQLite, local file — no external service required) ─────────────
# Relative paths are resolved from the `prisma/` directory.
DATABASE_URL="file:./sentinelwa.db"

# ── Secrets ──────────────────────────────────────────────────────────────────
# 32-byte key (hex or base64) used to encrypt the Meta access token at rest.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Password for the operator console (dashboard, /settings, /api-keys, /chat).
# Leave blank to disable the console login (only do this on a trusted LAN).
CONSOLE_PASSWORD=

# Session cookie signing secret for the operator console.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Meta / WhatsApp Cloud API ────────────────────────────────────────────────
# These can also be set at runtime from the /settings page (stored encrypted in
# SQLite). Values in .env act as the bootstrap defaults on first start.
META_API_VERSION=v21.0
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_APP_SECRET=
# Token you type into the Meta App Dashboard "Verify token" field.
META_WEBHOOK_VERIFY_TOKEN=
# Default authentication template used by POST /api/v1/send-otp
META_OTP_TEMPLATE_NAME=otp_verification
META_OTP_TEMPLATE_LANG=en_US

# ── Gateway behaviour ────────────────────────────────────────────────────────
# Set to true to simulate Meta responses without any outbound network calls.
# Useful for offline development and staging drills.
MOCK_META=false
# Default per-minute rate limit applied to a newly generated API key.
DEFAULT_RATE_LIMIT_PER_MIN=120
# Comma-separated CIDR/IP allowlist applied to every /api/v1 call.
# Empty = allow any source (per-key allowlists still apply).
GLOBAL_IP_WHITELIST=
# Retention for log rows and request metrics, in days.
LOG_RETENTION_DAYS=14
# Circuit breaker: consecutive Meta failures before the breaker opens.
BREAKER_FAILURE_THRESHOLD=5
# Milliseconds the breaker stays open before a half-open probe.
BREAKER_RESET_MS=30000
